6e1d262d46ad3634fae","text":"[REDACTED]","truncated":true},"stdout":{"redacted":false,"sha256":"f07fc4f05ffe8929f6a8ad94b12da75ec3da450f6d561def9264b1feaa5dd5b4","text":"QIITA-STYLE-1\n\n# CIのテストが3日に1回落ちていた原因\n\nCIのテストが、3日に1回ほど落ちていました。\n\n原因は、テスト同士が同じ一時ディレクトリを使い回していたことでした。並列実行に変えてから、この問題が顕在化しました。\n\n対応は、テストごとに一時ディレクトリを分けるようにしただけです。該当したテストは3件でした。\n\nなお、速くなったかどうかは測っていません。\n","truncated":false}},{"checks":[{"detail":"","spec":"contains:QIITA-STYLE-1","status":"pass"},{"detail":"","spec":"contains:一時ディレクトリ","status":"pass"},{"detail":"","spec":"contains:3件","status":"pass"},{"detail":"","spec":"not_contains:%","status":"pass"},{"detail":"","spec":"not_contains:この記事では","status":"pass"},{"detail":"","spec":"not_contains:いかがでしょうか","status":"pass"},{"detail":"","spec":"not_contains:シームレス","status":"pass"},{"detail":"","spec":"not_contains:泥臭い","status":"pass"},{"detail":"","spec":"not_contains:執筆方針","status":"pass"}],"elapsed_s":30.566442,"index":3,"infra_status":null,"judge":{"criteria":[{"id":"no_material_added","score":1.0,"status":"pass"},{"id":"casual_phrasing_not_evenly_spaced","score":1.0,"status":"pass"},{"id":"abstraction_removed_not_invented","score":1.0,"status":"pass"}],"status":"measured"},"outcome":"pass","returncode":0,"stderr":{"redacted":true,"sha256":"0d65872c149f000b8017835a3742e2d59bd0f42e85789c28495865e2fcc746e5","text":"[REDACTED]","truncated":true},"stdout":{"redacted":false,"sha256":"e3d7311caf9503269714552102ab0868fc51c5ad3d69c50f8e64d948ef874f08","text":"QIITA-STYLE-1。\n\n# 並列実行で顕在化した、一時ディレクトリの使い回し\n\nCIのテストが3日に1回落ちていた。\n\n原因は、テスト同士が同じ一時ディレクトリを使い回していたことだった。並列実行に変えてから顕在化した。\n\n## 直したこと\n\nテストごとに一時ディレクトリを切るようにした。それだけだ。\n\n速くなったかは測っていない。該当したテストは3件だった。\n","truncated":false}}]}
