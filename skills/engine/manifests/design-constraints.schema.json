{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/itoh-shun/rig/skills/engine/manifests/design-constraints.schema.json",
  "title": "rig design constraints",
  "description": "プロジェクトが所有するデザイン制約。design tokens・component inventory・禁止表現を機械可読に持つ。scripts/check_design_constraints.py が読む。",
  "type": "object",
  "required": ["version", "tokens"],
  "additionalProperties": false,
  "properties": {
    "_readme": { "type": "string" },
    "version": { "const": 1 },
    "tokens": {
      "description": "グループ名 -> トークン名 -> 値。グループ名は自由（color/spacing/font/radius など）。センサーは値の見た目から種別（色・長さ・フォント）を判定するので、グループ名に依存しない。",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": { "type": "string", "minLength": 1 }
      }
    },
    "components": {
      "description": "使用してよいコンポーネント名の全集合。成果物中の <Capitalized> 参照をこの集合と突き合わせる。空配列はコンポーネント検査を無効にするのではなく『1つも許可しない』を意味する。検査したくない場合はキーごと省く。",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "prohibited": {
      "description": "禁止表現。既定は部分文字列一致。regex: true で正規表現。",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern", "why"],
        "additionalProperties": false,
        "properties": {
          "pattern": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "regex": { "type": "boolean", "default": false },
          "case_sensitive": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
